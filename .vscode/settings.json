{
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "cmake.sourceDirectory": "${workspaceFolder}",
  "cmake.generator": "Ninja",
  "cmake.buildDirectory": "${workspaceFolder}/build",
  "cmake.configureOnOpen": false,
  "editor.formatOnSave": true,
  "C_Cpp.formatting": "clangFormat",
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },
  "files.associations": {
    "*.h": "c",
    "*.hpp": "cpp"
  },
  "code-runner.runInTerminal": true,
  "code-runner.clearPreviousOutput": true,
  "code-runner.saveFileBeforeRun": true,
  "code-runner.executorMap": {
    "c": "Clear-Host && Set-Location $dir && gcc -std=c17 -Wall -O2 -I$workspaceRoot/include $fileName -o $fileNameWithoutExt.exe 2>nul && .\\$fileNameWithoutExt.exe; Write-Host ''",
    "cpp": "Clear-Host && Set-Location $dir && g++ -std=c++17 -Wall -O2 -I$workspaceRoot/include *.cpp -o app.exe 2>nul && .\\app.exe; Write-Host ''"
  }
}
