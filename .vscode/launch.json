{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Depurar con GDB (CMake)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "stopAtEntry": true,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "MIMode": "gdb",
      "windows": {
        "externalConsole": true,
        "miDebuggerPath": "gdb.exe"
      },
      "linux": {
        "externalConsole": false,
        "miDebuggerPath": "/usr/bin/gdb"
      },
      "osx": {
        "MIMode": "lldb"
      },
      "setupCommands": [
        {
          "description": "Habilitar formateo visual de estructuras (pretty printing)",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
